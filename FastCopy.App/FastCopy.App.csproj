<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 릴리스 버전의 바닥값: Actions 러너는 마지막 릴리스의 다음 번호를 고름 (예전 i-luncher 버전 1.0.3 부터 이어감) -->
    <Version>2.0.0</Version>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>FastCopy</AssemblyName>
    <AssemblyTitle>FastCopy</AssemblyTitle>
    <Product>FastCopy</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FastCopy.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../FastCopy.Core/FastCopy.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/FastCopy.ico"/><Resource Include="Assets/FastCopy-24.png"/><Resource Include="Assets/FastCopy-32.png"/></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/*.ttf"/>
    <Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <!-- i-luncher AppKit: 자체 업데이트(update.json)와 릴리스 zip -->
  <Import Project="AppKit\AppKit.targets" />
</Project>
